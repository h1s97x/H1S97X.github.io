index 853d812bb364c329fe6b84d8d7c4acde3a129a73..870da7046cb854d0685a465905db12d33f15f031 100644
--- a/src/components/GlobalStyles.astro
+++ b/src/components/GlobalStyles.astro
@@ -1,3 +1,18 @@
 ---
-
+// 主题全局样式入口。
+// 这些样式此前并未被任何组件显式引用，只是「顺带」被 ImageWrapper.astro 里
+// 过宽的 `import.meta.glob("../../**")` 扫进来，加载顺序取决于文件系统枚举顺序。
+// 顺序一旦变化（例如 main.css 排到 markdown.css 之后），markdown.css 里的
+// `@apply link`/`@apply expand-animation` 找不到 main.css 中定义的类，
+// Tailwind 会直接报错：The `link` class does not exist。
+// 这里显式、固定顺序地加载，消除对 glob 顺序的隐式依赖。
+import "../styles/variables.styl";
+import "../styles/main.css";
+import "../styles/markdown.css";
+import "../styles/markdown-extend.styl";
+import "../styles/scrollbar.css";
+import "../styles/transition.css";
+import "../styles/photoswipe.css";
+import "../styles/expressive-code.css";
 ---
+
